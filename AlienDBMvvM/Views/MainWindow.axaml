<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlienDBMvvM.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AlienDBMvvM.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Height="450"
        Width="800"
        Icon="/Assets/avalonia-logo.ico"
        Title="AlienDBMvvM">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="20">
        
        <TextBlock 
            Text="Filmy Alien" 
            FontSize="20" 
            Margin="10"
            HorizontalAlignment="Center"/>
        
        <Grid 
            ColumnDefinitions="*,*,*" 
            RowDefinitions="Auto, Auto, Auto"
            Margin="50, 0">
            
            <ListBox 
                Grid.ColumnSpan="3" 
                ItemsSource="{Binding Films}"
                SelectedItem="{Binding SelectedFilm, Mode=TwoWay}"
                x:Name="FilmsListBox">
                
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PolishTitle, StringFormat=| {0} |}"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Ocena: {0}/10}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <Button
                Grid.Column="0"
                Grid.Row="1"
                Content="Dodaj Film"
                Margin="10"
                Background="LimeGreen"
                HorizontalAlignment="Right"
                Command="{Binding AddFilmCommand}"/>
            
            <Button
                Grid.Column="1"
                Grid.Row="1"
                Content="Usuń Film"
                Margin="10"
                Background="Red"
                HorizontalAlignment="Center"/>
            
            <Button
                Grid.Column="2"
                Grid.Row="1"
                Content="Szczegóły"
                Margin="10"
                Background="CornflowerBlue"
                HorizontalAlignment="Left"
                Command="{Binding ShowDetailsCommand}"/>
            
        </Grid>
        <Grid ColumnDefinitions="*,*" 
              RowDefinitions="Auto, Auto,Auto, Auto,Auto, Auto,Auto, Auto,Auto, Auto,Auto, Auto"
              Width="450">
            <TextBlock Text="Wpisz tytuł filmu: "/>
            <TextBox Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="1" Text="Wpisz polski tytuł filmu: "/>
            <TextBox Grid.Row="1" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="2" Text="Wpisz datę wyjścia: "/>
            <TextBox Grid.Row="2" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="3" Text="Wpisz dyrektora: "/>
            <TextBox Grid.Row="3" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="4" Text="Wpisz osobę która pisała ekran: "/>
            <TextBox Grid.Row="4" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="5" Text="Wpisz ten wyraz z którym pan ma problem: "/>
            <TextBox Grid.Row="5" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="6" Text="Wpisz długość filmu: "/>
            <TextBox Grid.Row="6" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="7" Text="Wpisz jak bardzo się podobał film: "/>
            <TextBox Grid.Row="7" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="8" Text="Wpisz główne postaie: "/>
            <TextBox Grid.Row="8" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="9" Text="Wpisz nazwę statku: "/>
            <TextBox Grid.Row="9" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="10" Text="Wpisz opis filmu: "/>
            <TextBox Grid.Row="10" Grid.Column="1" Width="200"/>
            
            <TextBlock Grid.Row="11" Text="Wpisz ciekawostkę: "/>
            <TextBox Grid.Row="11" Grid.Column="1" Width="200"/>
            
        </Grid>
        
    </StackPanel>
</Window>
